# Portfolio Prism Environment Variables
# Copy this file to .env and fill in your values

# Finnhub API key for market data (get free key from https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# GitHub fine-grained PAT for telemetry/error reporting (optional)
# Permissions needed: Issues (write) on Skeptomenos/Portfolio-Prism
GITHUB_ISSUES_TOKEN=your_github_pat_here
