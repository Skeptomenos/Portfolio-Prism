# Portfolio Prism - Environment Variables
# ========================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Then edit .env with your actual keys.

# -----------------------------------------------------------------------------
# REQUIRED: Finnhub API Key
# -----------------------------------------------------------------------------
# Used for: ISIN resolution, company metadata enrichment
# Get free key at: https://finnhub.io/register
# Free tier: 60 API calls/minute (sufficient for personal use)
#
FINNHUB_API_KEY=your_finnhub_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: OpenFIGI API Key
# -----------------------------------------------------------------------------
# Used for: Alternative ISIN resolution (currently not in main pipeline)
# Get free key at: https://www.openfigi.com/api
#
# OPENFIGI_API_KEY=your_openfigi_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Pipeline Settings
# -----------------------------------------------------------------------------
# Enable portfolio validation after pipeline run (compares to ground truth)
# VALIDATE_PORTFOLIO=false
